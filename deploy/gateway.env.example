# 게이트웨이 설정. cp deploy/gateway.env.example gateway.env 로 복사해서 고친다.
# 토큰(DEVICE_TOKEN)은 여기 말고 .env 에 둔다.
# 이 파일에선 $(...) 같은 명령을 못 쓴다. Tailscale 주소는 PREVIEW_HOST=tailscale 로 알아서 찾는다.

ROOM_CAMERA=0
YOLO_MODEL=gateway/yolov8s.onnx
ROOM_ITEMS=remote:1
PREVIEW_PORT=8090
PREVIEW_HOST=tailscale

# 책상 부분 (미리보기의 하늘색 desk 상자가 책상에 맞게). 정리 확인 때 책상만 확대해서 한 번 더 봄
DESK_AREA=0.25,0.22,0.64,0.83
# 깨끗한 책상 사진과 비교 (팀 결정 뒤 켜기). 이름 붙이기 모델은 tools/export_world.py로 만들면 더 잘 붙음
# DESK_PHOTO=1
# LABEL_MODEL=gateway/yolov8s-worldv2.onnx

# 연습(서버로 안 보냄). core #81이 dev 서버에 올라가면 지우고 SEND_SENSORS=1 로 바꾼다
DRY_RUN=1
# SEND_SENSORS=1
# SERVER=https://<dev 서버 주소>
