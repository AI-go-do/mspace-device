# 게이트웨이 설정. cp deploy/gateway.env.example gateway.env 로 복사해서 고친다.
# 토큰(DEVICE_TOKEN)은 여기 말고 .env 에 둔다.
# 이 파일에선 $(...) 같은 명령을 못 쓴다. Tailscale 주소는 PREVIEW_HOST=tailscale 로 알아서 찾는다.

ROOM_CAMERA=0
YOLO_MODEL=gateway/yolov8s.onnx
ROOM_ITEMS=remote:1
PREVIEW_PORT=8090
PREVIEW_HOST=tailscale

# 책상 부분 (미리보기의 하늘색 desk 상자가 책상에 맞게). 정리 확인 때 책상만 확대해서 한 번 더 봄
DESK_AREA=0.25,0.22,0.64,0.83
# 깨끗한 책상 사진과 비교 (팀 결정 뒤 켜기). 이름 붙이기 모델은 tools/export_world.py로 만들면 더 잘 붙음
# DESK_PHOTO=1
# LABEL_MODEL=gateway/yolov8s-worldv2.onnx
# 정리 확인 때 사람 없는 빈 방 사진을 core에 올려 관리자 화면에서 보기 (docs Q-27, SEND_SENSORS=1일 때만)
# TIDY_PHOTOS=1

# 연습(서버로 안 보냄). core #81이 dev 서버에 올라가면 지우고 SEND_SENSORS=1 로 바꾼다
DRY_RUN=1
# SEND_SENSORS=1
# SERVER=https://<dev 서버 주소>

# ---- 10판 1등(87.2%) + VLM + 가짜 센서로 돌릴 때 (bash deploy/install-service.sh all) ----
# 위 줄들 대신 아래를 쓴다 (같은 이름이 두 번 있으면 아래 것이 이김). DRY_RUN=1 줄은 지운다.
# 설명은 꼭 줄 맨 앞 # 로 (값 뒤에 # 를 붙이면 systemd가 값으로 읽어요)
# 꼭 있어야 함: 가짜 센서는 젯슨 안 브로커에만. .env의 교육장 주소보다 이 줄이 이김
# MQTT_HOST=localhost
# MQTT_ROOMS=가상-1:1
# QR_CAMERA=0
# ROOM_CAMERA=2
# DESK_PHOTO=1
# DESK_LIGHT=ssim
# DESK_THRESH=25
# DESK_MOVE=1
# VLM_URL=http://127.0.0.1:8091
# 젯슨이 막 켜졌을 때 VLM 서버가 모델을 올리는 동안 기다리는 초
# VLM_WAIT=120
# SEND_SENSORS=1
# TIDY_PHOTOS=1
# SERVER=https://<dev 서버 주소>
