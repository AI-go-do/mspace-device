# 젯슨이 켜지면 게이트웨이를 자동으로 켜는 systemd 서비스.
# 직접 고치지 말고 deploy/install-service.sh 로 설치한다 (@USER@, @REPO@, @PYTHON@을 채워 줌).
[Unit]
Description=M-SPACE gateway (QR, room camera)
Wants=network-online.target tailscaled.service
# VLM·가짜 센서 서비스를 설치했으면 그것들 다음에 켠다 (설치 안 했으면 이 줄은 아무 일도 안 함)
After=network-online.target tailscaled.service mosquitto.service mspace-vlm.service mspace-fake-sensors.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
# 토큰은 .env, 설정은 gateway.env (둘 다 저장소에 안 올라감). 앞의 - 는 "파일이 없어도 괜찮음"
# 뒤에 읽는 gateway.env가 이긴다: .env에 교육장 MQTT_HOST가 있어도 gateway.env의 MQTT_HOST=localhost를 쓴다
# (손으로 켤 때 .env를 읽고 MQTT_HOST=localhost를 앞에 붙이던 것과 같게. 가짜 센서 값이 밖으로 안 나가게)
EnvironmentFile=-@REPO@/.env
EnvironmentFile=-@REPO@/gateway.env
ExecStart=@PYTHON@ -u gateway/gateway.py
# 꺼지면(카메라·USB가 잠깐 빠져도) 5초 뒤 다시 켠다
Restart=always
RestartSec=5
# 화면 출력은 그동안처럼 gateway.log에 이어 쓴다: tail -f gateway.log
StandardOutput=append:@REPO@/gateway.log
StandardError=append:@REPO@/gateway.log

[Install]
WantedBy=multi-user.target
