// 이 파일을 secrets.h로 복사해서 값을 넣는다.
//   cp secrets.h.example secrets.h
// secrets.h는 .gitignore에 있어서 GitHub에 올라가지 않는다.
// 비밀번호·토큰은 채팅·단톡방에 붙여 넣지 않는다.
#pragma once

// 와이파이. ESP32는 2.4GHz만 된다
#define WIFI_SSID  "와이파이 이름"
#define WIFI_PASS  "와이파이 비밀번호"

// 서버 (DRY_RUN 0일 때만 쓴다)
// 운영은 https만. 장치 토큰이 요청마다 실리기 때문이다
#define SERVER_URL    "https://dev-mspace.java21.net"
// 지금 core에는 장치 토큰이 하나뿐이다. 센서용 토큰을 따로(장치마다) 둘지는 정하는 중.
// 토큰은 재웅님께 DM으로만 받는다
#define DEVICE_TOKEN  "재웅님께 DM으로 받은 장치 토큰"

// https 서버를 확인할 "루트" 인증서 (PEM). 비밀 값은 아니다.
// 루트만 넣는다. 서버 인증서나 중간 인증서(R10·E5 등)는 60~90일마다 바뀌어서, 넣으면 갱신 때 모든 장치가 끊긴다.
// 학교 서버는 Let's Encrypt라서 ISRG Root X1 + ISRG Root X2를 이어 붙여 넣는다 (둘 다 넣으면 RSA·ECDSA 모두 통과)
//   받는 곳: https://letsencrypt.org/certificates/ 의 isrgrootx1.pem, isrg-root-x2.pem
// 비워 두면 https로 보내지 않는다 (확인 없이 보내면 가짜 서버에 토큰을 줄 수 있어서)
// 넣는 모양 (한 줄마다 따옴표와 \n, 줄 끝에 \):
//   #define SERVER_CA_PEM \
//     "-----BEGIN CERTIFICATE-----\n" \
//     "MIIFazCCA1Og...\n" \
//     "-----END CERTIFICATE-----\n" \
//     "-----BEGIN CERTIFICATE-----\n" \
//     "...X2...\n" \
//     "-----END CERTIFICATE-----\n"
#define SERVER_CA_PEM ""

// 맥에 띄운 core(같은 와이파이, http://192.168.x.x:8411)로 시험할 때만 1.
// http는 토큰이 그대로 보이므로 시험이 끝나면 꼭 0으로 되돌린다
#define ALLOW_HTTP_FOR_LOCAL_TEST 0
